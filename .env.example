SECRET_KEY=change-this-to-a-long-random-string
PORT=3522
# Optional: set this only after mounting a persistent volume at /data
# DATA_DIR=/data

# Firebase Web configuration is supplied in app.py and is public client configuration.
# Never put a Firebase service-account private key in this file or the public repository.
# Configure FIREBASE_SERVICE_ACCOUNT_JSON as a deployment secret, preferably as
# the complete JSON value (never commit the key to GitHub).
